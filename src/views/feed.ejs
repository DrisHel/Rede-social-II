<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Feed</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-blue-50 min-h-screen">
    <header class="bg-blue-950 text-white px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <% if (currentUser.avatarUrl) { %>
          <img src="<%= currentUser.avatarUrl %>" alt="" class="w-9 h-9 rounded-full object-cover" />
        <% } %>
        <div>
          <h1 class="text-lg font-semibold">Rede social - Poppin</h1>
          <p class="text-blue-200 text-sm">
            Logado como <strong><%= currentUser.name %></strong>
            (<%= currentUser._count.following %> seguindo, <%= currentUser._count.followers %> seguidores)
          </p>
          <p data-activity-notifications aria-live="polite" class="text-blue-200 text-sm">
            Novas curtidas/comentários desde o último acesso:
            <strong data-activity-total><%= activity.total %></strong>
            (<span data-new-likes><%= activity.likes %></span> curtidas,
            <span data-new-comments><%= activity.comments %></span> comentários)
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="/posts/new" class="bg-sky-100 text-blue-950 text-sm rounded px-3 py-1.5 hover:bg-sky-200">
          Novo post
        </a>
        <form method="post" action="/logout">
          <button type="submit" class="text-blue-200 text-sm hover:text-white">Sair</button>
        </form>
      </div>
    </header>

    <main class="max-w-4xl mx-auto mt-8 px-4 grid grid-cols-1 md:grid-cols-3 gap-6">
      <section class="md:col-span-2 flex flex-col gap-4">
        <h2 class="text-blue-700 text-sm font-medium uppercase tracking-wide">Seu feed</h2>
        <% if (feed.length === 0) { %>
          <p data-feed-empty class="bg-white border border-blue-100 rounded-lg shadow p-6 text-sm text-blue-700">
            Ninguém que você segue postou ainda. Siga alguém na coluna ao lado.
          </p>
        <% } %>
        <div
          data-feed-list
          data-next-cursor="<%= nextCursor === null ? '' : nextCursor %>"
          data-has-more="<%= hasMore ? 'true' : 'false' %>"
        >
          <%- include('partials/feedPosts', { feed, currentUser }) %>
        </div>
        <div data-feed-sentinel class="py-2 text-center">
          <p data-feed-loading hidden class="text-sm text-blue-500">Carregando mais publicações...</p>
          <div data-feed-error hidden class="text-sm text-red-600">
            <p data-feed-error-message>Não foi possível carregar mais publicações.</p>
            <button type="button" data-feed-retry class="underline">Tentar novamente</button>
          </div>
          <p data-feed-end hidden class="text-sm text-blue-500">Você chegou ao fim do feed.</p>
        </div>
      </section>

      <aside class="flex flex-col gap-3">
        <h2 class="text-blue-700 text-sm font-medium uppercase tracking-wide">Pessoas</h2>
        <div class="bg-white border border-blue-100 rounded-lg shadow divide-y divide-blue-100">
          <% others.forEach((user) => { %>
            <div class="flex items-center justify-between px-4 py-3">
              <span class="text-sm text-blue-950"><%= user.name %></span>
              <% if (user.isFollowing) { %>
                <span class="text-xs text-emerald-700">Já segue</span>
              <% } else { %>
                <form method="post" action="/follow">
                  <input type="hidden" name="targetId" value="<%= user.id %>" />
                  <button type="submit" class="text-xs bg-emerald-200 text-emerald-950 rounded px-2 py-1 hover:bg-emerald-300">
                    Seguir
                  </button>
                </form>
              <% } %>
            </div>
          <% }) %>
        </div>
      </aside>
    </main>
    <script src="/assets/likes.js" defer></script>
    <script src="/assets/comments.js" defer></script>
    <script src="/assets/feedCarousel.js" defer></script>
    <script src="/assets/feedInfiniteScroll.js" defer></script>
  </body>
</html>
