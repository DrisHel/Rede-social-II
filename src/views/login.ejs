<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-blue-50 min-h-screen flex items-center justify-center">
    <main class="bg-white border border-blue-100 shadow rounded-lg p-8 w-full max-w-sm">
      <h1 class="text-xl font-semibold text-blue-950 mb-1">Entrar</h1>
      <p class="text-sm text-blue-700 mb-6">
        Usuários semeados (<code>npm run prisma:seed</code>): ana@exemplo.com / bruno@exemplo.com / carla@exemplo.com,
        senha <code>senha123</code>.
      </p>

      <% if (error) { %>
        <p class="bg-red-50 text-red-700 text-sm rounded px-3 py-2 mb-4"><%= error %></p>
      <% } %>

      <form method="post" action="/login" class="flex flex-col gap-3">
        <label class="text-sm text-blue-800">
          E-mail
          <input type="email" name="email" required class="mt-1 w-full border border-blue-200 rounded px-3 py-2 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" />
        </label>
        <label class="text-sm text-blue-800">
          Senha
          <input type="password" name="password" required class="mt-1 w-full border border-blue-200 rounded px-3 py-2 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" />
        </label>
        <button type="submit" class="bg-blue-800 text-white rounded px-3 py-2 mt-2 hover:bg-blue-900">
          Entrar
        </button>
      </form>

      <p class="text-sm text-blue-700 mt-4">
        Não tem conta? <a href="/register" class="text-sky-700 underline hover:text-blue-950">Cadastre-se</a>.
      </p>
    </main>
  </body>
</html>
