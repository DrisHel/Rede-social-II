<% feed.forEach((post) => { %>
  <% const likeCount = post._count?.likes ?? 0; %>
  <% const commentCount = post._count?.comments ?? 0; %>
  <% const likedByMe = post.likedByMe ?? false; %>
  <article data-post-id="<%= post.id %>" class="bg-white border border-blue-100 rounded-lg shadow p-4">
    <header class="flex items-center justify-between">
      <p class="text-sm font-medium text-blue-950"><%= post.author.name %></p>
      <p class="text-xs text-blue-400"><%= new Date(post.createdAt).toLocaleString('pt-BR') %></p>
    </header>
    <a href="/posts/<%= post.id %>" class="block group">
      <p class="text-blue-900 mt-2 group-hover:text-blue-950"><%= post.content %></p>
    </a>
    <% if (post.images.length === 1) { %>
      <a href="/posts/<%= post.id %>" class="block">
        <img src="<%= post.images[0].url %>" alt="" class="mt-3 rounded-lg max-h-80 w-full object-cover" />
      </a>
    <% } else if (post.images.length > 1) { %>
      <div data-image-carousel role="group" aria-roledescription="carrossel" aria-label="Fotos da publicação" class="relative mt-3 overflow-hidden rounded-lg bg-blue-50">
        <% post.images.forEach((image, index) => { %>
          <div data-carousel-slide class="h-64" <%= index === 0 ? '' : 'hidden' %>>
            <a href="/posts/<%= post.id %>" class="block h-full">
              <img src="<%= image.url %>" alt="" class="h-full w-full object-cover" />
            </a>
          </div>
        <% }) %>
        <button
          type="button"
          data-carousel-prev
          aria-label="Foto anterior"
          class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-blue-950/80 text-white w-9 h-9 hover:bg-blue-950"
        >
          ‹
        </button>
        <button
          type="button"
          data-carousel-next
          aria-label="Próxima foto"
          class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-blue-950/80 text-white w-9 h-9 hover:bg-blue-950"
        >
          ›
        </button>
        <span data-carousel-indicator role="status" aria-live="polite" class="absolute bottom-2 right-2 rounded-full bg-blue-950/80 text-white text-xs px-2 py-1">
          1 / <%= post.images.length %>
        </span>
      </div>
    <% } %>
    <% if (post.tags.length > 0) { %>
      <div class="flex gap-2 mt-3 flex-wrap">
        <% post.tags.forEach((tag) => { %>
          <span class="text-xs bg-emerald-100 text-emerald-900 rounded-full px-2 py-0.5">#<%= tag.name %></span>
        <% }) %>
      </div>
    <% } %>
    <footer class="flex items-center gap-4 mt-3 pt-3 border-t border-blue-100">
      <button
        type="button"
        data-like-button
        data-post-id="<%= post.id %>"
        data-like-url="/posts/<%= post.id %>/like"
        aria-pressed="<%= likedByMe %>"
        title="<%= likedByMe ? 'Descurtir' : 'Curtir' %>"
        class="flex items-center gap-1.5 text-sm <%= likedByMe ? 'text-red-600' : 'text-blue-600' %> hover:text-red-600"
      >
        <svg data-like-icon viewBox="0 0 24 24" class="w-5 h-5" fill="<%= likedByMe ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
        </svg>
        <span data-like-count><%= likeCount %></span>
      </button>
      <span data-like-status role="status" aria-live="polite" class="text-xs text-red-600"></span>
      <a href="/posts/<%= post.id %>" title="Comentários" class="flex items-center gap-1.5 text-sm text-blue-600 hover:text-blue-950">
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75h6.75m-6.75 3h4.5M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25-9 3.694-9 8.25c0 1.6.497 3.096 1.356 4.36.1.148.14.33.107.507l-.713 3.133 3.94-1.02c.16-.042.33-.02.48.043 1.15.49 2.45.767 3.83.767Z" />
        </svg>
        <span data-comment-count><%= commentCount %></span>
      </a>
      <% if (post.authorId === currentUser.id) { %>
        <form method="post" action="/posts/<%= post.id %>/delete" class="ml-auto">
          <button type="submit" class="text-xs text-red-600 hover:underline">Apagar</button>
        </form>
      <% } %>
    </footer>
    <section
      data-comment-section
      data-post-id="<%= post.id %>"
      data-current-user-id="<%= currentUser.id %>"
      class="mt-3"
    >
      <ul data-comment-list class="divide-y">
        <% if (post.comments.length === 0) { %>
          <li data-empty-comments class="text-xs text-blue-500 py-2">Ainda não há comentários.</li>
        <% } %>
        <% post.comments.forEach((comment) => { %>
          <% const commentLikedByMe = comment.likedByMe ?? false; %>
          <% const commentLikeCount = comment._count?.commentLikes ?? 0; %>
          <li data-comment-id="<%= comment.id %>" class="py-2">
            <div class="flex items-center justify-between gap-3">
              <p class="text-xs font-medium text-blue-950"><%= comment.author.name %></p>
              <div class="flex items-center gap-2">
                <time class="text-xs text-blue-400"><%= new Date(comment.createdAt).toLocaleString('pt-BR') %></time>
                <% if (comment.authorId === currentUser.id) { %>
                  <button type="button" data-delete-comment data-comment-id="<%= comment.id %>" class="text-xs text-red-600 hover:underline">
                    Apagar
                  </button>
                <% } %>
              </div>
            </div>
            <p class="text-sm text-blue-900 mt-1 whitespace-pre-wrap"><%= comment.content %></p>
            <div class="flex items-center gap-2 mt-1">
              <button
                type="button"
                data-like-button
                data-comment-like-button
                data-like-url="/posts/<%= post.id %>/comments/<%= comment.id %>/like"
                aria-pressed="<%= commentLikedByMe %>"
                title="<%= commentLikedByMe ? 'Descurtir' : 'Curtir' %>"
                class="flex items-center gap-1 text-xs <%= commentLikedByMe ? 'text-red-600' : 'text-blue-600' %> hover:text-red-600"
              >
                <svg data-like-icon viewBox="0 0 24 24" class="w-4 h-4" fill="<%= commentLikedByMe ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                </svg>
                <span data-like-count><%= commentLikeCount %></span>
              </button>
              <span data-like-status role="status" aria-live="polite" class="text-xs text-red-600"></span>
            </div>
          </li>
        <% }) %>
      </ul>
      <form data-comment-form action="/posts/<%= post.id %>/comments" method="post" class="flex gap-2 mt-2">
        <label class="sr-only" for="comment-<%= post.id %>">Escreva um comentário</label>
        <input
          id="comment-<%= post.id %>"
          name="content"
          required
          placeholder="Escreva um comentário..."
          class="min-w-0 flex-1 border border-blue-200 rounded px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100"
        />
        <button type="submit" class="bg-blue-800 text-white text-xs rounded px-3 hover:bg-blue-900">
          Comentar
        </button>
      </form>
      <p data-comment-status role="status" aria-live="polite" class="text-xs text-red-600 mt-1"></p>
    </section>
  </article>
<% }) %>
