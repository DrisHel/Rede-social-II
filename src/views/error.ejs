<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Erro <%= status %></title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-blue-50 min-h-screen flex items-center justify-center">
    <main class="bg-white border border-blue-100 shadow rounded-lg p-8 max-w-md text-center">
      <p class="text-4xl font-bold text-blue-950"><%= status %></p>
      <p class="text-blue-800 mt-2"><%= message %></p>
      <a href="/" class="inline-block mt-6 text-sm text-sky-700 underline hover:text-blue-950">Voltar para o início</a>
    </main>
  </body>
</html>
