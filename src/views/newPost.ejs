<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Novo post</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-blue-50 min-h-screen">
    <header class="bg-blue-950 text-white px-6 py-4 flex items-center justify-between">
      <h1 class="text-lg font-semibold">Novo post</h1>
      <a href="/" class="text-blue-200 text-sm hover:text-white">&larr; Voltar para o feed</a>
    </header>

    <main class="max-w-lg mx-auto mt-8">
      <div class="bg-white border border-blue-100 shadow rounded-lg p-6">
        <% if (error) { %>
          <p class="bg-red-50 text-red-700 text-sm rounded px-3 py-2 mb-4"><%= error %></p>
        <% } %>

        <form method="post" action="/posts" enctype="multipart/form-data" class="flex flex-col gap-3">
          <label class="text-sm text-blue-800">
            Conteúdo
            <textarea name="content" required rows="4" class="mt-1 w-full border border-blue-200 rounded px-3 py-2 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100"></textarea>
          </label>
          <label class="text-sm text-blue-800">
            Tags (separadas por vírgula, opcional)
            <input type="text" name="tags" placeholder="prisma, orm" class="mt-1 w-full border border-blue-200 rounded px-3 py-2 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" />
          </label>
          <label class="text-sm text-blue-800">
            Imagem (opcional)
            <input type="file" name="image" accept="image/jpeg,image/png,image/webp" class="mt-1 w-full text-sm" />
          </label>
          <button type="submit" class="bg-blue-800 text-white rounded px-3 py-2 mt-2 hover:bg-blue-900">
            Publicar
          </button>
        </form>
      </div>
    </main>
  </body>
</html>
